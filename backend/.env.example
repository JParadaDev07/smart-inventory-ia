APP_NAME="Smart Inventory AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
API_URL=http://localhost:8000/api
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_inventory
DB_USERNAME=root
DB_PASSWORD=

FASTAPI_URL=http://ai-service:8000
FASTAPI_TIMEOUT=5

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Mail (for password reset). Use log driver in dev to write to storage/logs/laravel.log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Wompi (Colombia)
# En localhost: usa ngrok (ej. ngrok http 8000) y en el dashboard de Wompi configura
# la URL del webhook como https://TU-URL-NGROK/api/webhooks/wompi
WOMPI_ENVIRONMENT=test
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_REDIRECT_URL=
PSE_CURRENCY=COP

# Plans (COP / month)
PLAN_BASIC_PRICE=39900
PLAN_PRO_PRICE=79900
